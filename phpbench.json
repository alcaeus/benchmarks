{
    "$schema": null,
    "runner.bootstrap": "bootstrap.php",
    "runner.path": "src",
    "report.generators": {
        "ab-compare": {
            "generator": "component",
            "filter": "variant_params?.strategy = \"operator\" or variant_params?.strategy = \"pipeline\"",
            "components": [
                {
                    "component": "table_aggregate",
                    "title": "Operator vs Pipeline",
                    "partition": ["benchmark_name", "subject_name"],
                    "row": {
                        "benchmark": "first(partition['benchmark_name'])",
                        "subject": "first(partition['subject_name'])",
                        "operator": "display_as_time(mode(partition[variant_params?.strategy = \"operator\"][\"result_time_avg\"]), \"time\")",
                        "pipeline": "display_as_time(mode(partition[variant_params?.strategy = \"pipeline\"][\"result_time_avg\"]), \"time\")",
                        "delta": "percent_diff(mode(partition[variant_params?.strategy = \"operator\"][\"result_time_avg\"]), mode(partition[variant_params?.strategy = \"pipeline\"][\"result_time_avg\"]))"
                    }
                }
            ]
        }
    }
}